{
  "name": "wagebench",
  "version": "0.1.0",
  "private": true,
  "description": "Certified payroll review desk: check weekly contractor payrolls against the Davis-Bacon wage determination, track missing weeks and restitution, and produce review documentation. Runs entirely in the browser.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^6.0.3",
    "write-excel-file": "^2.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
